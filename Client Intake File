<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>New Client Details</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --navy: #1A2B4A; --navy-light: #243760;
    --teal: #0EA5E9; --teal-dark: #0284C7;
    --slate: #64748B; --slate-light: #94A3B8;
    --bg: #F0F4FA; --white: #FFFFFF;
    --border: #CBD5E1; --text: #1E293B;
    --success: #10B981; --error: #EF4444;
    --input-bg: #FAFBFF;
  }
  body {
    font-family: 'Inter', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
  }
  .card {
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(26,43,74,0.10), 0 1px 4px rgba(26,43,74,0.06);
    width: 100%; max-width: 560px;
    overflow: hidden;
  }
  .card-header {
    background: var(--navy);
    padding: 36px 40px 32px;
    text-align: center;
  }
  .logo-mark {
    width: 48px; height: 48px;
    background: var(--teal);
    border-radius: 12px;
    display: inline-flex;
    align-items: center; justify-content: center;
    margin-bottom: 16px;
  }
  .logo-mark svg { width: 26px; height: 26px; fill: white; }
  .card-header h1 { color: var(--white); font-size: 22px; font-weight: 700; letter-spacing: -0.3px; margin-bottom: 6px; }
  .card-header p { color: var(--slate-light); font-size: 14px; }
  .card-body { padding: 36px 40px 40px; }
  .field { margin-bottom: 24px; }
  label { display: block; font-size: 13px; font-weight: 600; color: var(--slate); letter-spacing: 0.2px; margin-bottom: 8px; text-transform: uppercase; }
  input {
    width: 100%; background: var(--input-bg);
    border: 1.5px solid var(--border); border-radius: 12px;
    padding: 16px 18px;
    font-family: 'Inter', sans-serif; font-size: 17px; font-weight: 400; color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
    outline: none; -webkit-appearance: none;
  }
  input::placeholder { color: var(--slate-light); font-weight: 300; }
  input:focus { border-color: var(--teal); box-shadow: 0 0 0 4px rgba(14,165,233,0.12); background: var(--white); }
  input.has-value { border-color: #CBD5E1; background: var(--white); }
  input.error { border-color: var(--error); box-shadow: 0 0 0 4px rgba(239,68,68,0.10); }
  .error-msg { display: none; font-size: 12px; color: var(--error); margin-top: 6px; font-weight: 500; }
  input.error + .error-msg { display: block; }

  /* Setup banner */
  .setup-banner {
    background: #FFF7ED; border: 1.5px solid #FED7AA;
    border-radius: 12px; padding: 14px 16px;
    margin-bottom: 24px;
    display: flex; gap: 12px; align-items: flex-start;
  }
  .setup-banner.connected { background: #ECFDF5; border-color: #6EE7B7; }
  .setup-banner svg { flex-shrink: 0; margin-top: 1px; }
  .setup-banner-text { flex: 1; }
  .setup-banner-text strong { display: block; font-size: 13px; font-weight: 600; color: #92400E; margin-bottom: 3px; }
  .setup-banner.connected .setup-banner-text strong { color: #065F46; }
  .setup-banner-text span { font-size: 12px; color: #B45309; line-height: 1.4; }
  .setup-banner.connected .setup-banner-text span { color: #047857; }
  .script-url-row { display: flex; gap: 8px; margin-top: 10px; }
  .script-url-input { flex: 1; padding: 10px 14px !important; font-size: 13px !important; border-radius: 8px !important; }
  .btn-connect {
    background: var(--navy); color: white; border: none;
    border-radius: 8px; padding: 10px 16px;
    font-family: 'Inter', sans-serif; font-size: 13px; font-weight: 600;
    cursor: pointer; white-space: nowrap; flex-shrink: 0;
  }
  .btn-connect:hover { background: var(--navy-light); }

  .divider { height: 1px; background: #F1F5F9; margin: 8px 0 28px; }
  .btn-row { display: flex; gap: 12px; margin-top: 8px; }
  button {
    font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600;
    border: none; border-radius: 12px; cursor: pointer;
    transition: background 0.15s, transform 0.1s;
    -webkit-tap-highlight-color: transparent;
  }
  .btn-save {
    flex: 1; background: var(--navy); color: white;
    padding: 17px 24px;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-save:hover { background: var(--navy-light); }
  .btn-save:active { transform: scale(0.98); }
  .btn-save:disabled { background: var(--slate-light); cursor: not-allowed; }
  .btn-clear { background: #F1F5F9; color: var(--slate); padding: 17px 22px; }
  .btn-clear:hover { background: #E2E8F0; }
  .spinner { width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.7s linear infinite; display: none; }

  /* QR Panel */
  .qr-section {
    margin-top: 32px;
    width: 100%; max-width: 560px;
  }
  .qr-card {
    background: var(--white);
    border-radius: 20px;
    box-shadow: 0 4px 24px rgba(26,43,74,0.10), 0 1px 4px rgba(26,43,74,0.06);
    overflow: hidden;
  }
  .qr-card-header {
    background: var(--navy);
    padding: 18px 24px;
    display: flex; align-items: center; gap: 12px;
  }
  .qr-card-header svg { flex-shrink: 0; }
  .qr-card-header h2 { color: white; font-size: 16px; font-weight: 700; }
  .qr-card-header p { color: var(--slate-light); font-size: 13px; margin-top: 2px; }
  .qr-card-body { padding: 28px 32px; }

  .qr-setup-state { text-align: center; padding: 12px 0; }
  .qr-setup-state p { color: var(--slate); font-size: 14px; line-height: 1.6; }
  .qr-setup-state a { color: var(--teal); text-decoration: none; font-weight: 600; }
  .qr-setup-state a:hover { text-decoration: underline; }

  .qr-url-row { display: flex; gap: 8px; margin-top: 16px; }
  .qr-url-input {
    flex: 1; padding: 12px 16px !important;
    font-size: 14px !important; border-radius: 10px !important;
  }
  .btn-generate {
    background: var(--teal); color: white; border: none;
    border-radius: 10px; padding: 12px 18px;
    font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600;
    cursor: pointer; white-space: nowrap; flex-shrink: 0;
  }
  .btn-generate:hover { background: var(--teal-dark); }

  .qr-display { display: none; }
  .qr-inner {
    display: flex; gap: 28px; align-items: center;
  }
  .qr-box {
    background: white;
    border: 3px solid var(--navy);
    border-radius: 16px;
    padding: 12px;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  #qrcode canvas, #qrcode img { display: block; border-radius: 6px; }
  .qr-info { flex: 1; }
  .qr-info h3 { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .qr-info p { font-size: 13px; color: var(--slate); line-height: 1.6; margin-bottom: 12px; }
  .qr-url-display {
    background: #F8FAFC;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 11px;
    color: var(--slate);
    word-break: break-all;
    line-height: 1.5;
  }
  .qr-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }
  .btn-qr-action {
    font-family: 'Inter', sans-serif;
    font-size: 13px; font-weight: 600;
    border-radius: 8px; padding: 9px 14px;
    cursor: pointer; border: none;
    display: flex; align-items: center; gap: 6px;
    transition: background 0.15s;
  }
  .btn-download-qr { background: var(--navy); color: white; }
  .btn-download-qr:hover { background: var(--navy-light); }
  .btn-reset-qr { background: #F1F5F9; color: var(--slate); }
  .btn-reset-qr:hover { background: #E2E8F0; }

  /* Print sheet */
  .print-sheet {
    display: none;
    margin-top: 12px;
    background: #F8FAFC;
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 14px 18px;
    font-size: 13px;
    color: var(--slate);
    line-height: 1.6;
  }
  .print-sheet.show { display: block; }
  .btn-print {
    background: none; border: none;
    color: var(--teal); font-size: 13px; font-weight: 600;
    cursor: pointer; padding: 0; font-family: 'Inter', sans-serif;
    text-decoration: underline;
  }

  /* Entries */
  .entries-section { margin-top: 32px; width: 100%; max-width: 560px; }
  .entries-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; padding: 0 4px; }
  .entries-header h3 { font-size: 13px; font-weight: 600; color: var(--slate); text-transform: uppercase; letter-spacing: 0.3px; }
  .entries-count { background: var(--navy); color: white; font-size: 11px; font-weight: 700; border-radius: 20px; padding: 2px 10px; }
  .entries-list { display: flex; flex-direction: column; gap: 10px; }
  .entry-row {
    background: white; border-radius: 14px; padding: 16px 20px;
    display: flex; align-items: center; justify-content: space-between;
    box-shadow: 0 1px 4px rgba(26,43,74,0.07); gap: 12px;
  }
  .entry-info { flex: 1; min-width: 0; }
  .entry-name { font-size: 15px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .entry-detail { font-size: 13px; color: var(--slate); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .entry-badges { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .entry-badge { background: #EFF6FF; color: #3B82F6; font-size: 12px; font-weight: 600; border-radius: 8px; padding: 4px 10px; }
  .sync-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); flex-shrink: 0; }
  .sync-dot.pending { background: #F59E0B; }
  .sync-dot.failed { background: var(--error); }
  .btn-delete { background: none; border: none; color: #CBD5E1; padding: 4px; cursor: pointer; border-radius: 6px; transition: color 0.15s, background 0.15s; flex-shrink: 0; display: flex; align-items: center; }
  .btn-delete:hover { color: var(--error); background: #FEF2F2; }
  .export-btn {
    width: 100%; margin-top: 14px; padding: 13px;
    background: white; color: var(--slate);
    border: 1.5px solid var(--border); border-radius: 12px;
    font-size: 14px; display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .export-btn:hover { background: #F8FAFC; color: var(--navy); border-color: var(--navy); }

  /* Success overlay */
  .success-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(26,43,74,0.45); backdrop-filter: blur(4px);
    align-items: center; justify-content: center; z-index: 100; padding: 24px;
  }
  .success-overlay.show { display: flex; }
  .success-card {
    background: white; border-radius: 20px; padding: 40px 36px;
    text-align: center; max-width: 380px; width: 100%;
    box-shadow: 0 20px 60px rgba(26,43,74,0.2);
    animation: pop 0.25s cubic-bezier(0.34,1.56,0.64,1);
  }
  @keyframes pop { from { transform: scale(0.85); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .success-icon { width: 64px; height: 64px; background: #ECFDF5; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; }
  .success-icon svg { width: 32px; height: 32px; }
  .success-card h2 { font-size: 20px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .success-card p { font-size: 15px; color: var(--slate); margin-bottom: 4px; line-height: 1.5; }
  .success-name { font-weight: 600; color: var(--navy); }
  .sync-status { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--success); font-weight: 500; margin-top: 8px; }
  .sync-status.syncing { color: var(--slate); }
  .sync-status.failed { color: var(--error); }
  .btn-next { width: 100%; margin-top: 24px; padding: 16px; background: var(--teal); color: white; border-radius: 12px; font-size: 15px; }
  .btn-next:hover { background: var(--teal-dark); }

  /* Toast */
  .toast {
    position: fixed; bottom: 32px; left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: var(--text); color: white;
    padding: 14px 22px; border-radius: 12px;
    font-size: 14px; font-weight: 500; z-index: 200;
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s;
    opacity: 0; white-space: nowrap;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }
  .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
  .toast.success { background: #065F46; }
  .toast.error-toast { background: #991B1B; }

  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 480px) {
    .card-header, .card-body { padding-left: 24px; padding-right: 24px; }
    .card-header { padding-top: 28px; padding-bottom: 24px; }
    .card-body { padding-top: 28px; padding-bottom: 32px; }
    input { font-size: 16px; }
    .qr-inner { flex-direction: column; text-align: center; }
    .qr-card-body { padding: 20px; }
  }

  @media print {
    body { background: white; padding: 0; justify-content: flex-start; }
    .card, .entries-section, .qr-section .qr-card-header { display: none; }
    .qr-section { margin: 0; }
    .qr-card { box-shadow: none; border: none; }
    .qr-card-header { display: none; }
    .qr-card-body { padding: 0; }
    .qr-setup-state { display: none; }
    .qr-actions, .btn-reset-qr, .print-sheet { display: none !important; }
    .qr-display { display: block !important; }
    .print-only { display: block !important; }
    .qr-inner { justify-content: center; }
  }
  .print-only { display: none; text-align: center; margin-top: 16px; }
  .print-only h2 { font-size: 22px; color: var(--navy); margin-bottom: 6px; }
  .print-only p { font-size: 15px; color: var(--slate); }
</style>
</head>
<body>

<!-- Main form card -->
<div class="card">
  <div class="card-header">
    <div class="logo-mark">
      <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
    </div>
    <h1>New Client Details</h1>
    <p>Fill in the details while you chat</p>
  </div>

  <div class="card-body">

    <div class="setup-banner" id="setupBanner">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div class="setup-banner-text">
        <strong>Connect to Google Sheets</strong>
        <span>Paste your Apps Script URL to save directly to your spreadsheet.</span>
        <div class="script-url-row">
          <input type="url" id="scriptUrl" class="script-url-input" placeholder="https://script.google.com/macros/s/..." autocomplete="off" autocorrect="off" spellcheck="false">
          <button class="btn-connect" onclick="connectSheet()">Connect</button>
        </div>
      </div>
    </div>

    <div class="field">
      <label for="name">Full Name</label>
      <input type="text" id="name" placeholder="e.g. Sarah Johnson" autocomplete="off" autocorrect="off" spellcheck="false">
      <div class="error-msg">Please enter the client's name</div>
    </div>
    <div class="field">
      <label for="email">Email Address</label>
      <input type="email" id="email" placeholder="e.g. sarah@email.com" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="none">
      <div class="error-msg">Please enter a valid email address</div>
    </div>
    <div class="field">
      <label for="phone">Phone Number</label>
      <input type="tel" id="phone" placeholder="e.g. 07700 900 123" autocomplete="off">
      <div class="error-msg">Please enter a phone number</div>
    </div>
    <div class="field">
      <label for="postcode">Postcode</label>
      <input type="text" id="postcode" placeholder="e.g. SW1A 1AA" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="characters" style="text-transform:uppercase;">
      <div class="error-msg">Please enter a postcode</div>
    </div>

    <div class="divider"></div>

    <div class="btn-row">
      <button class="btn-save" id="saveBtn" onclick="saveEntry()">
        <div class="spinner" id="spinner"></div>
        <svg id="saveIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span id="saveBtnText">Save Client</span>
      </button>
      <button class="btn-clear" onclick="clearForm()">Clear</button>
    </div>
  </div>
</div>

<!-- QR Code card -->
<div class="qr-section" id="qrSection">
  <div class="qr-card">
    <div class="qr-card-header">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
        <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="3" height="3"/>
        <rect x="18" y="14" width="3" height="3"/><rect x="14" y="18" width="3" height="3"/>
        <rect x="18" y="18" width="3" height="3"/>
        <rect x="5" y="5" width="3" height="3"/><rect x="16" y="5" width="3" height="3"/><rect x="5" y="16" width="3" height="3"/>
      </svg>
      <div>
        <h2>Share via QR Code</h2>
        <p>Clients scan to fill in their own details</p>
      </div>
    </div>

    <div class="qr-card-body">
      <!-- Before URL entered -->
      <div class="qr-setup-state" id="qrSetupState">
        <p>Once your form is hosted online, paste the URL here to generate a scannable QR code.<br><br>
        <strong>Don't have a URL yet?</strong> See the <a href="#" onclick="alert('Check the setup-instructions file for GitHub Pages hosting steps.')">setup guide</a> for free hosting with GitHub Pages — takes 5 minutes.</p>
        <div class="qr-url-row">
          <input type="url" id="qrUrl" class="qr-url-input" placeholder="https://yourusername.github.io/client-form/" autocomplete="off" autocorrect="off" spellcheck="false">
          <button class="btn-generate" onclick="generateQR()">Generate</button>
        </div>
      </div>

      <!-- After URL entered -->
      <div class="qr-display" id="qrDisplay">
        <div class="qr-inner">
          <div class="qr-box">
            <div id="qrcode"></div>
          </div>
          <div class="qr-info">
            <h3>Ready to scan!</h3>
            <p>Show or print this QR code and clients can open the form on their own phone or tablet instantly.</p>
            <div class="qr-url-display" id="qrUrlDisplay"></div>
            <div class="qr-actions">
              <button class="btn-qr-action btn-download-qr" onclick="downloadQR()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download
              </button>
              <button class="btn-qr-action btn-reset-qr" onclick="printQR()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Print
              </button>
              <button class="btn-qr-action btn-reset-qr" onclick="resetQR()">Change URL</button>
            </div>
          </div>
        </div>
        <!-- Print-only content -->
        <div class="print-only">
          <h2>Scan to fill in your details</h2>
          <p id="printUrl"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Saved entries -->
<div class="entries-section" id="entriesSection" style="display:none;">
  <div class="entries-header">
    <h3>Saved Today</h3>
    <span class="entries-count" id="entriesCount">0</span>
  </div>
  <div class="entries-list" id="entriesList"></div>
  <button class="export-btn" onclick="exportCSV()">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
    Export as CSV (backup)
  </button>
</div>

<!-- Success overlay -->
<div class="success-overlay" id="successOverlay">
  <div class="success-card">
    <div class="success-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <h2>Details Saved!</h2>
    <p><span class="success-name" id="successName"></span> has been added.</p>
    <div class="sync-status syncing" id="syncStatus">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation:spin 1s linear infinite"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
      Syncing to Google Sheets…
    </div>
    <button class="btn-next" onclick="closeSuccess()">Add Next Client</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
  // ── State ──────────────────────────────────────────────────
  let scriptUrl = localStorage.getItem('sheetsScriptUrl') || '';
  let savedQrUrl = localStorage.getItem('qrUrl') || '';
  let entries = JSON.parse(localStorage.getItem('clientEntries') || '[]');

  // ── Init ───────────────────────────────────────────────────
  if (scriptUrl) { document.getElementById('scriptUrl').value = scriptUrl; showConnected(); }
  if (savedQrUrl) { document.getElementById('qrUrl').value = savedQrUrl; generateQR(); }
  renderEntries();

  document.getElementById('postcode').addEventListener('input', function() { this.value = this.value.toUpperCase(); });
  ['name','email','phone','postcode'].forEach(id => {
    document.getElementById(id).addEventListener('input', function() {
      this.classList.toggle('has-value', this.value.trim().length > 0);
      this.classList.remove('error');
    });
  });

  // ── Sheets connect ─────────────────────────────────────────
  function connectSheet() {
    const url = document.getElementById('scriptUrl').value.trim();
    if (!url.startsWith('https://script.google.com/macros/s/')) { showToast('Please paste a valid Apps Script URL', 'error-toast'); return; }
    scriptUrl = url;
    localStorage.setItem('sheetsScriptUrl', scriptUrl);
    showConnected();
    showToast('Connected to Google Sheets ✓', 'success');
  }

  function showConnected() {
    const b = document.getElementById('setupBanner');
    b.classList.add('connected');
    b.innerHTML = `
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <div class="setup-banner-text">
        <strong>Connected to Google Sheets</strong>
        <span>Client details sync automatically. <a href="#" onclick="disconnectSheet(event)" style="color:#047857;text-decoration:underline;">Disconnect</a></span>
      </div>`;
  }

  function disconnectSheet(e) { e.preventDefault(); scriptUrl = ''; localStorage.removeItem('sheetsScriptUrl'); location.reload(); }

  // ── QR Code ────────────────────────────────────────────────
  let qrInstance = null;

  function generateQR() {
    const url = document.getElementById('qrUrl').value.trim();
    if (!url.startsWith('http')) { showToast('Please enter a valid URL starting with https://', 'error-toast'); return; }

    savedQrUrl = url;
    localStorage.setItem('qrUrl', url);

    document.getElementById('qrSetupState').style.display = 'none';
    document.getElementById('qrDisplay').style.display = 'block';
    document.getElementById('qrUrlDisplay').textContent = url;
    document.getElementById('printUrl').textContent = url;

    const container = document.getElementById('qrcode');
    container.innerHTML = '';

    qrInstance = new QRCode(container, {
      text: url,
      width: 180,
      height: 180,
      colorDark: '#1A2B4A',
      colorLight: '#FFFFFF',
      correctLevel: QRCode.CorrectLevel.M
    });
  }

  function downloadQR() {
    setTimeout(() => {
      const canvas = document.querySelector('#qrcode canvas');
      if (!canvas) { showToast('QR not ready yet, try again', 'error-toast'); return; }
      const link = document.createElement('a');
      link.download = 'client-form-qr.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
    }, 100);
  }

  function printQR() { window.print(); }

  function resetQR() {
    localStorage.removeItem('qrUrl');
    savedQrUrl = '';
    document.getElementById('qrcode').innerHTML = '';
    document.getElementById('qrDisplay').style.display = 'none';
    document.getElementById('qrSetupState').style.display = 'block';
    document.getElementById('qrUrl').value = '';
  }

  // ── Validate ───────────────────────────────────────────────
  function validate() {
    let valid = true;
    const checks = [
      { id: 'name',     test: v => v.trim().length > 0 },
      { id: 'email',    test: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) },
      { id: 'phone',    test: v => v.trim().length > 0 },
      { id: 'postcode', test: v => v.trim().length > 0 },
    ];
    checks.forEach(({ id, test }) => {
      const el = document.getElementById(id);
      if (!test(el.value)) { el.classList.add('error'); valid = false; }
      else el.classList.remove('error');
    });
    return valid;
  }

  // ── Save ───────────────────────────────────────────────────
  async function saveEntry() {
    if (!validate()) return;
    const entry = {
      id: Date.now(),
      name:     document.getElementById('name').value.trim(),
      email:    document.getElementById('email').value.trim(),
      phone:    document.getElementById('phone').value.trim(),
      postcode: document.getElementById('postcode').value.trim().toUpperCase(),
      savedAt:  new Date().toLocaleString('en-GB'),
      syncState: scriptUrl ? 'pending' : 'local',
    };
    setSaving(true);
    entries.unshift(entry);
    persistEntries();
    document.getElementById('successName').textContent = entry.name;
    setSyncStatus('syncing');
    document.getElementById('successOverlay').classList.add('show');
    setSaving(false);
    renderEntries();
    if (scriptUrl) {
      try {
        await sendToSheets(entry);
        entry.syncState = 'synced';
        persistEntries(); setSyncStatus('synced'); renderEntries();
      } catch {
        entry.syncState = 'failed';
        persistEntries(); setSyncStatus('failed'); renderEntries();
      }
    } else { setSyncStatus('local'); }
  }

  async function sendToSheets(entry) {
    const params = new URLSearchParams({ name: entry.name, email: entry.email, phone: entry.phone, postcode: entry.postcode, savedAt: entry.savedAt });
    await fetch(`${scriptUrl}?${params}`, { method: 'GET', mode: 'no-cors' });
  }

  function setSaving(on) {
    document.getElementById('saveBtn').disabled = on;
    document.getElementById('spinner').style.display = on ? 'block' : 'none';
    document.getElementById('saveIcon').style.display = on ? 'none' : 'block';
    document.getElementById('saveBtnText').textContent = on ? 'Saving…' : 'Save Client';
  }

  function setSyncStatus(state) {
    const el = document.getElementById('syncStatus');
    const icons = {
      syncing: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="animation:spin 1s linear infinite"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>`,
      synced:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
      failed:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
    };
    const msgs = { syncing: 'Syncing to Google Sheets…', synced: 'Saved to Google Sheets', failed: 'Sync failed — saved locally', local: 'Saved locally (no Sheets connected)' };
    el.className = 'sync-status' + (state === 'syncing' ? ' syncing' : state === 'failed' ? ' failed' : '');
    el.innerHTML = (icons[state] || '') + ' ' + msgs[state];
  }

  function closeSuccess() { document.getElementById('successOverlay').classList.remove('show'); clearForm(); document.getElementById('name').focus(); }

  function clearForm() {
    ['name','email','phone','postcode'].forEach(id => {
      const el = document.getElementById(id); el.value = ''; el.classList.remove('error','has-value');
    });
  }

  function persistEntries() { localStorage.setItem('clientEntries', JSON.stringify(entries)); }

  function deleteEntry(id) { entries = entries.filter(e => e.id !== id); persistEntries(); renderEntries(); }

  function renderEntries() {
    const section = document.getElementById('entriesSection');
    const list    = document.getElementById('entriesList');
    document.getElementById('entriesCount').textContent = entries.length;
    if (!entries.length) { section.style.display = 'none'; return; }
    section.style.display = 'block';
    list.innerHTML = entries.map(e => `
      <div class="entry-row">
        <div class="entry-info">
          <div class="entry-name">${escHtml(e.name)}</div>
          <div class="entry-detail">${escHtml(e.email)} &nbsp;·&nbsp; ${escHtml(e.phone)}</div>
        </div>
        <div class="entry-badges">
          <span class="entry-badge">${escHtml(e.postcode)}</span>
          ${scriptUrl ? `<span class="sync-dot ${e.syncState === 'synced' ? '' : e.syncState === 'failed' ? 'failed' : 'pending'}" title="${e.syncState === 'synced' ? 'Synced' : e.syncState === 'failed' ? 'Sync failed' : 'Pending'}"></span>` : ''}
        </div>
        <button class="btn-delete" onclick="deleteEntry(${e.id})" title="Remove">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
        </button>
      </div>`).join('');
  }

  function exportCSV() {
    if (!entries.length) return;
    const csv = ['Name,Email,Phone,Postcode,Saved At', ...entries.map(e => [e.name,e.email,e.phone,e.postcode,e.savedAt].map(v=>`"${v.replace(/"/g,'""')}"`).join(','))].join('\n');
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
    a.download = `clients-${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
  }

  let toastTimer;
  function showToast(msg, cls='') {
    const t = document.getElementById('toast');
    t.textContent = msg; t.className = 'toast ' + cls + ' show';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
  }

  function escHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
</script>
</body>
</html>
